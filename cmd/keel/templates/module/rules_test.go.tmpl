package {%.Module%}

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestCleanName(t *testing.T) {
	tests := []struct {
		name, in, want string
		wantInvalid    bool
	}{
		{"kept as typed", "Front desk", "Front desk", false},
		{"surrounding space trimmed", "  Front desk \t", "Front desk", false},
		{"blank refused", "   ", "", true},
		{"at the limit in characters, not bytes", strings.Repeat("é", maxName), strings.Repeat("é", maxName), false},
		{"over the limit refused", strings.Repeat("a", maxName+1), "", true},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got, err := cleanName(tt.in)
			if tt.wantInvalid {
				var invalid *InvalidError
				require.ErrorAs(t, err, &invalid)
				assert.Equal(t, "name", invalid.Fields[0].Field)
				return
			}
			require.NoError(t, err)
			assert.Equal(t, tt.want, got)
		})
	}
}
