# Copy to .env for local work. Placeholder values only.
APP_ENV=local
APP_HTTP_ADDR=127.0.0.1:8080
APP_LOG_FORMAT=text
# part:keel
# keel holds both engines; the Postgres lines come later, so they win.
# /part:keel
# part:mysql
APP_DATABASE_URL=mysql://root:keel-local@127.0.0.1:3316/keel
# /part:mysql
# part:postgres
APP_DATABASE_URL=postgres://keel_app:keel-app-local@127.0.0.1:5442/keel?sslmode=disable
APP_DATABASE_MIGRATE_URL=postgres://keel_owner:keel-owner-local@127.0.0.1:5442/keel?sslmode=disable
# /part:postgres
# part:tenancy
APP_DATABASE_OPERATOR_URL=postgres://keel_operator:keel-operator-local@127.0.0.1:5442/keel?sslmode=disable
# /part:tenancy

# part:postgres
KEEL_PG_PORT=5442
# /part:postgres
# part:mysql
KEEL_MYSQL_PORT=3316
# /part:mysql
# part:mail
KEEL_SMTP_PORT=1025
KEEL_MAIL_UI_PORT=8025
# /part:mail
# part:pdf
KEEL_PDF_PORT=3000
# /part:pdf
# part:files
KEEL_S3_PORT=8333
# /part:files
