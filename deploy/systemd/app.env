# /etc/app/app.env: settings both slots share, no secrets. Plain KEY=value lines without quotes, since
# the same file feeds systemd, docker --env-file and release.sh.
APP_ENV=production
APP_PUBLIC_URL=https://app.example.com
APP_PROXY_TRUSTED=127.0.0.1/32
# Drain plus shutdown must cover the write timeout, or a stopping slot cuts requests still within
# their time; release.sh refuses to run otherwise.
APP_HTTP_WRITE_TIMEOUT=60s
APP_HTTP_SHUTDOWN_DRAIN=5s
APP_HTTP_SHUTDOWN_TIMEOUT=60s
# part:mail
# Mail carries reset, verification and invite links; production refuses the log driver. The SMTP
# password is a secret: pass it as APP_MAIL_SMTP_PASSWORD_FILE from a credential.
APP_MAIL_DRIVER=smtp
APP_MAIL_FROM=no-reply@example.com
APP_MAIL_SMTP_HOST=smtp.example.com
# /part:mail
